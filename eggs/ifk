    .show { animation: bpop 2.1s ease-out forwards; }

    /* ---------- SOURCE VIEWER (bottom-left button + editor panel) ---------- */
    #codeBtn {
        position: fixed;
        left: calc(env(safe-area-inset-left) + 14px);
        bottom: calc(env(safe-area-inset-bottom) + 14px);
        width: clamp(56px, 15vw, 72px);
        height: clamp(56px, 15vw, 72px);
        z-index: 45;
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 2px;
        border-radius: 16px;
        border: 2px solid #2ff3ff;
        background: rgba(4,14,24,.72);
        color: #bffcff;
        font-family: 'Orbitron', sans-serif;
        box-shadow: 0 0 14px rgba(47,243,255,.45), inset 0 0 12px rgba(47,243,255,.18);
        cursor: pointer;
        pointer-events: auto;
        -webkit-tap-highlight-color: transparent;
        transition: transform .12s ease, box-shadow .2s ease, background .2s ease;
    }
    #codeBtn:active { transform: scale(.92); background: rgba(47,243,255,.25); }
    #codeBtn .glyph { font-size: clamp(17px,4.6vw,22px); font-weight: 900; line-height:1; }
    #codeBtn .lbl { font-size: 8px; letter-spacing: 1.5px; opacity: .8; }

    #codePanel {
        position: fixed; inset: 0; z-index: 60;
        display: none;
        flex-direction: column;
        background: rgba(2,7,14,.965);
        backdrop-filter: blur(3px);
        padding: calc(env(safe-area-inset-top) + 58px) 12px calc(env(safe-area-inset-bottom) + 14px) 12px;
        font-family: 'Orbitron', sans-serif;
    }
    #codePanel.open { display: flex; }
    #codeHead {
        display: flex; align-items: center; justify-content: space-between;
        gap: 8px; margin-bottom: 8px; flex: 0 0 auto;
    }
    #codeTitle {
        color: #2ff3ff; font-size: clamp(11px,3.1vw,14px); font-weight: 900;
        letter-spacing: 2px; text-shadow: 0 0 12px rgba(47,243,255,.7);
    }
    #codeMeta { color: #6f8f9c; font-size: 9px; letter-spacing: 1px; }
    #codeArea {
        flex: 1 1 auto;
        width: 100%;
        min-height: 0;
        margin: 0;
        padding: 10px 10px 40vh 10px;
        border-radius: 10px;
        border: 1px solid rgba(47,243,255,.35);
        background: #04101a;
        color: #b6ffd9;
        caret-color: #ff4bd8;
        font-family: ui-monospace, Menlo, Consolas, monospace;
