        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        transition: background .15s ease, border-color .15s ease, color .15s ease, transform .1s ease, box-shadow .2s ease;
    }
    .cbtn:active { transform: scale(.96); }
    .cbtn.wide { flex: 1.5 1 0; }
    .cbtn.flash-ok {
        background: #14ff8a; border-color: #b6ffd9; color: #032013;
        box-shadow: 0 0 26px rgba(20,255,138,.85);
    }
    .cbtn.flash-bad { background: rgba(255,170,60,.25); border-color: #ffaa3c; color: #ffe6bd; }
</style>
