        touch-action: pan-y;
        user-select: text; -webkit-user-select: text;
        box-shadow: inset 0 0 24px rgba(0,0,0,.7);
    }
    #codeArea::selection { background: #ff4bd8; color: #fff; }
    #codeFoot { display: flex; gap: 8px; margin-top: 10px; flex: 0 0 auto; }
    .cbtn {
        flex: 1 1 0;
        min-height: 46px;
        border-radius: 10px;
