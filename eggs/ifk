<script>
/**
 * AUDIO ENGINE
 */
const Audio = {
    ctx: null, masterGain: null, engineOsc: null, engineGain: null, engineFilter: null,
    musicInterval: null, noteIndex: 0,
    bassNotes: [65.41, 77.78, 87.31, 98.00], 

    init: function() {
        if (!this.ctx) {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if(!AudioContext) return; 
            this.ctx = new AudioContext();
            this.masterGain = this.ctx.createGain();
            this.masterGain.gain.value = 0.3; 
            this.masterGain.connect(this.ctx.destination);
            
            this.engineOsc = this.ctx.createOscillator();
            this.engineOsc.type = 'sawtooth';
            this.engineGain = this.ctx.createGain();
            this.engineGain.gain.value = 0;
            this.engineFilter = this.ctx.createBiquadFilter();
            this.engineFilter.type = 'lowpass';
            this.engineFilter.frequency.value = 200;
            this.engineOsc.connect(this.engineFilter);
            this.engineFilter.connect(this.engineGain);
            this.engineGain.connect(this.masterGain);
            this.engineOsc.start();
            this.startMusic();
        }
        if(this.ctx.state === 'suspended') this.ctx.resume();
    },
    playCoin: function(pitch) {
        if(!this.ctx || this.ctx.state === 'suspended') return;
        const p = pitch || 1;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(1200*p, this.ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(2400*p, this.ctx.currentTime + 0.1);
        gain.gain.setValueAtTime(0.2, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.4);
        osc.connect(gain); gain.connect(this.masterGain);
        osc.start(); osc.stop(this.ctx.currentTime + 0.4);
    },
    playZone: function() {
        if(!this.ctx || this.ctx.state === 'suspended') return;
        const base = 293.66;
        [0,4,7,12,16,19].forEach((st,i)=>{
            const t = this.ctx.currentTime + i*0.075;
            const o = this.ctx.createOscillator(), g = this.ctx.createGain();
            o.type = 'square';
            o.frequency.setValueAtTime(base*Math.pow(2, st/12), t);
            g.gain.setValueAtTime(0.0001, t);
            g.gain.exponentialRampToValueAtTime(0.16, t+0.012);
            g.gain.exponentialRampToValueAtTime(0.001, t+0.55);
            o.connect(g); g.connect(this.masterGain);
            o.start(t); o.stop(t+0.6);
        });
        const n = this.ctx.createOscillator(), ng = this.ctx.createGain();
        n.type='sawtooth'; n.frequency.setValueAtTime(90, this.ctx.currentTime);
        n.frequency.exponentialRampToValueAtTime(40, this.ctx.currentTime+0.5);
        ng.gain.setValueAtTime(0.25, this.ctx.currentTime);
        ng.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime+0.6);
        n.connect(ng); ng.connect(this.masterGain);
        n.start(); n.stop(this.ctx.currentTime+0.6);
    },
    drawSoundOsc: null, drawSoundGain: null,
    startDrawSound: function() {
        if(!this.ctx || this.drawSoundOsc || this.ctx.state === 'suspended') return;
        this.drawSoundOsc = this.ctx.createOscillator();
        this.drawSoundOsc.type = 'triangle';
        this.drawSoundOsc.frequency.value = 120;
        this.drawSoundGain = this.ctx.createGain();
        this.drawSoundGain.gain.setValueAtTime(0, this.ctx.currentTime);
        this.drawSoundGain.gain.linearRampToValueAtTime(0.08, this.ctx.currentTime + 0.05);
        this.drawSoundOsc.connect(this.drawSoundGain);
        this.drawSoundGain.connect(this.masterGain);
        this.drawSoundOsc.start();
    },
    stopDrawSound: function() {
        if(this.drawSoundOsc) {
            try {
                this.drawSoundGain.gain.linearRampToValueAtTime(0, this.ctx.currentTime + 0.05);
                this.drawSoundOsc.stop(this.ctx.currentTime + 0.05);
            } catch(e){}
            this.drawSoundOsc = null;
        }
    },
    updateEngine: function(speed) {
        if(!this.ctx || !this.engineOsc) return;
        const targetFreq = Math.max(50, 60 + (speed * 4));
        this.engineOsc.frequency.setTargetAtTime(targetFreq, this.ctx.currentTime, 0.1);
        const vol = Math.min(0.1, Math.abs(speed) / 40);
        this.engineGain.gain.setTargetAtTime(vol, this.ctx.currentTime, 0.1);
        this.engineFilter.frequency.setTargetAtTime(200 + (Math.abs(speed) * 40), this.ctx.currentTime, 0.1);
    },
    startMusic: function() {
        if(this.musicInterval) clearInterval(this.musicInterval);
        this.noteIndex = 0;
        this.musicInterval = setInterval(() => {
            if(!this.ctx || this.ctx.state === 'suspended') return;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = 'sawtooth';
            const freq = this.bassNotes[this.noteIndex % 4];
            osc.frequency.setValueAtTime(this.noteIndex%8===7 ? freq/2 : freq, this.ctx.currentTime);
            gain.gain.setValueAtTime(0.1, this.ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.3);
            osc.connect(gain); gain.connect(this.masterGain);
            osc.start(); osc.stop(this.ctx.currentTime + 0.3);
            this.noteIndex++;
        }, 300);
    }
};

/**
 * GAME CONFIGURATION
 */
const CFG = {
    gravity: 0.22,      
    baseSpeed: 8.0,     
    maxSpeed: 45,        
    motorPower: 0.35,    
    friction: 0.998,    
    subSteps: 10,        
    drawSmoothing: 4,   
    lineLife: 4000,     
    starCount: 80,
    adhesion: 0.5        // Force that keeps ball on line once touching
};

/**
 * ZONES - the map changes every 500 points
 */
const ZONE_STEP = 500;
const ZONES = [
    { name:'NEON GRID',    hue:240, decor:'diamonds', amb:'spark', grav:1.00, motor:1.00, coin:50  },
    { name:'TOXIC CAVERN', hue:110, decor:'crystals', amb:'spore', grav:1.18, motor:1.06, coin:60  },
    { name:'SOLAR FLARE',  hue:24,  decor:'rays',     amb:'ember', grav:0.88, motor:1.18, coin:75  },
    { name:'DEEP FREEZE',  hue:188, decor:'shards',   amb:'snow',  grav:1.10, motor:1.12, coin:90  },
    { name:'VOID BLOOM',   hue:300, decor:'orbs',     amb:'dust',  grav:0.68, motor:1.16, coin:110 },
    { name:'GOLD CIRCUIT', hue:46,  decor:'pillars',  amb:'spark', grav:1.25, motor:1.38, coin:150 }
];
const TUNE = { gravity: CFG.gravity, motor: CFG.motorPower, adhesion: CFG.adhesion, maxSpeed: CFG.maxSpeed, coin: 50 };

const store = (()=>{ let m={}; try { const t='__t'; localStorage.setItem(t,t); localStorage.removeItem(t); return localStorage; }
    catch(e) { return { getItem:k=> k in m? m[k]:null, setItem:(k,v)=>{m[k]=String(v)}, removeItem:k=>{delete m[k]} }; } })();

function hash1(i){ const x = Math.sin(i*127.1)*43758.5453; return x - Math.floor(x); }
function curZone(){ return ZONES[zoneIndex % ZONES.length]; }
function curCycle(){ return Math.floor(zoneIndex / ZONES.length); }

const cvs = document.getElementById('gameCanvas');
const ctx = cvs.getContext('2d', { alpha: false });
let W, H;

const elScore = document.getElementById('scoreVal');
const hud = document.getElementById('hud');

let score = 0;
let time = 0; 
let camX = 0;
let camY = 0;
let loopId = null; 

let player = { x: 0, y: 0, vx: 0, vy: 0, r: 14, angle: 0, isGlued: false };
let lines = [];
let items = [];
let particles = [];
let stars = [];
let floatingTexts = [];

let pointer = { x: 0, y: 0, down: false };
let lastDrawPos = { x: 0, y: 0 };
let worldHue = 240; 
let targetHue = 240;
let audioStarted = false;
let zoneIndex = 0;
let freeze = 0;
let flash = 0;
let shakeAmt = 0;
let ambient = [];
let rings = [];
let best = parseInt(store.getItem('gr_best') || '0', 10) || 0;
let maxZoneSeen = parseInt(store.getItem('gr_zone') || '0', 10) || 0;

const elBest = document.getElementById('best');
const elZoneName = document.getElementById('zoneName');
const elBar = document.getElementById('barFill');
const elNext = document.getElementById('nextTag');
const elBanner = document.getElementById('banner');

function makeAmbient() {
    ambient = [];
    for(let i=0;i<46;i++) ambient.push({
        x: Math.random()*window.innerWidth,
        y: Math.random()*window.innerHeight,
        s: 1 + Math.random()*2.6,
        vx: (Math.random()-0.5)*0.6,
        vy: (Math.random()-0.5)*0.6,
        ph: Math.random()*6.28
    });
}

function enterZone(idx, initial) {
    zoneIndex = idx;
    const z = curZone(), cyc = curCycle();
    targetHue = z.hue;
    if(initial) worldHue = z.hue;
    TUNE.gravity = CFG.gravity * z.grav;
    TUNE.motor = CFG.motorPower * z.motor * (1 + 0.09*cyc);
    TUNE.maxSpeed = CFG.maxSpeed * (1 + 0.07*cyc);
    TUNE.adhesion = CFG.adhesion;
    TUNE.coin = Math.round(z.coin * (1 + cyc));
    const label = 'ZONE ' + (idx+1) + ' \u00B7 ' + z.name + (cyc>0 ? ' +' + cyc : '');
    elZoneName.innerText = label;
    const nz = ZONES[(idx+1) % ZONES.length];
    const revealed = (idx+1) <= maxZoneSeen;
    elNext.innerText = 'NEXT: ' + (revealed ? nz.name : '???') + ' @ ' + ((idx+1)*ZONE_STEP);
    elBar.style.width = Math.min(100, ((score % ZONE_STEP) / ZONE_STEP) * 100) + '%';
    elBar.style.background = `hsl(${(z.hue+40)%360}, 100%, 62%)`;
    makeAmbient();
    updateTheme(worldHue);
    if(!initial) {
        flash = 1; shakeAmt = 22; freeze = 4;
        rings.push({ x: player.x, y: player.y, r: 10, life: 1 });
        rings.push({ x: player.x, y: player.y, r: 10, life: 1.35 });
        for(let i=0;i<40;i++){
            const a = Math.random()*6.28, sp = 3 + Math.random()*9;
            particles.push({ x: player.x, y: player.y, vx: Math.cos(a)*sp, vy: Math.sin(a)*sp,
                life: 1, size: 2 + Math.random()*4, color: `hsl(${z.hue + (Math.random()*60-30)}, 100%, ${60+Math.random()*30}%)` });
        }
        elBanner.querySelector('.t1').innerText = 'ZONE ' + (idx+1) + ' UNLOCKED';
        elBanner.querySelector('.t2').innerText = z.name;
        elBanner.style.color = `hsl(${z.hue}, 100%, 68%)`;
        elBanner.classList.remove('show'); void elBanner.offsetWidth; elBanner.classList.add('show');
        Audio.playZone();
        if(idx > maxZoneSeen) maxZoneSeen = idx;
        try { store.setItem('gr_best', String(best)); store.setItem('gr_zone', String(maxZoneSeen)); } catch(e){}
    }
}

function resize() {
    W = window.innerWidth;
    H = window.innerHeight;
    cvs.width = W;
    cvs.height = H;
    stars = [];
    for(let i=0; i<CFG.starCount; i++) {
        stars.push({
            x: Math.random() * W,
            y: Math.random() * H,
            size: Math.random() * 2,
            blink: Math.random()
        });
    }
}
window.addEventListener('resize', resize);
resize();

function initGame() {
    if (loopId) cancelAnimationFrame(loopId);
    score = 0;
    time = 0;
    elScore.innerText = "0";
    elBest.innerText = 'BEST ' + best;
    elBar.style.width = '0%';
    flash = 0; shakeAmt = 0; freeze = 0; rings = [];
    enterZone(0, true);
    lines = [];
    items = [];
    particles = [];
    floatingTexts = [];
    camX = 0;
    camY = 0;
    pointer.down = false;
    Audio.stopDrawSound();
    player = { x: 100, y: H/2, vx: CFG.baseSpeed, vy: 0, r: 14, angle: 0, isGlued: false };
    lines.push({ p1: {x: -1000, y: H/2 + 100}, p2: {x: 2000, y: H/2 + 100}, t: Infinity, perm: true });
    for(let i=0; i<5; i++) spawnChunk(1100 + i*450);
    if(audioStarted) Audio.startMusic();
    loop();
}

function updateTheme(hue) {
    const mainColor = `hsl(${hue}, 100%, 60%)`;
    hud.style.color = mainColor;
    hud.style.textShadow = `0 0 15px ${mainColor}`;
}

function updatePointer(e) {
    if(e.cancelable) e.preventDefault(); 
    const t = e.touches ? e.touches[0] : e;
    pointer.x = t.clientX;
    pointer.y = t.clientY;
}

functi